# ==================== 通用配置 ====================

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LOG_LEVEL=info
DEBUG=false

# 代理（按需填写）
HTTP_PROXY=
HTTPS_PROXY=

# ==================== Polymarket ====================

POLYMARKET_WS_HOST=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_WS_MAX_RECONNECT_ATTEMPTS=0
POLYMARKET_WS_RECONNECT_DELAY_MS=1000
POLYMARKET_WS_RECONNECT_DELAY_MAX_MS=30000

ORDERBOOK_MIN_IMBALANCE=3
ORDERBOOK_MIN_DEPTH=1000
ORDERBOOK_MIN_LIQUIDITY=20000

CSV_ENABLE_API_RANKINGS=false
CSV_FETCH_TIMEOUT_MS=15000
CSV_TRANSLATE=true
CSV_TRANSLATE_MAX=120

# ==================== Kalshi ====================

KALSHI_API_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_WS_URL=wss://api.elections.kalshi.com
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
